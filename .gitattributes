# Keep the distributed package small. The WordPress plugin commits its
# vendor/ directory and ships it inside the plugin zip, so anything not
# needed at runtime is dead weight in every install.
/tests                  export-ignore
/stubs                  export-ignore
/examples               export-ignore
/.github                export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon.dist      export-ignore
/.php-cs-fixer.dist.php export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/CHANGELOG.md           export-ignore
